<section class="panel panel-sow"><div class="panel-heading"><div><span class="eyebrow">Contract context</span><h2>SOW and capacity context</h2></div><span class="badge badge-{{ 'warning' if report.sow_capacity.interpretation != 'none' else 'ok' }}">{{ report.sow_capacity.interpretation|replace('_',' ')|upper }}</span></div><table class="data-table"><thead><tr><th>Metric</th><th class="numeric">SOW commitment</th><th class="numeric">Actual</th><th class="numeric">% of contract</th><th class="numeric">Capacity buffer</th><th>Status</th></tr></thead><tbody>{% for metric in report.sow_capacity.metrics %}<tr><td class="strong">{{ metric.name }}</td><td class="numeric">{{ '{:,.0f}'.format(metric.commitment) if metric.commitment is not none else 'Not supplied' }}</td><td class="numeric">{{ '{:,.0f}'.format(metric.actual) if metric.actual is not none else 'Not supplied' }}</td><td class="numeric">{{ '%.1f%%'|format(metric.pct_of_contract) if metric.pct_of_contract is not none else 'Not assessed' }}</td><td class="numeric">{{ '{:,.0f}'.format(metric.capacity_buffer) if metric.capacity_buffer is not none else 'Not supplied' }}</td><td><span class="badge badge-{{ metric.status|lower }}">{{ metric.status|replace('_',' ') }}</span></td></tr>{% else %}<tr><td colspan="6" class="muted">No SOW capacity metrics were loaded.</td></tr>{% endfor %}</tbody></table><p class="footnote">Testing-coverage risk means observed volume is not representative of contracted scale. Commercial review means SOW consumption requires an ownership decision.</p></section>
