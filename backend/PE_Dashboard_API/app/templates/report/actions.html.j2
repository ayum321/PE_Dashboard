<section class="panel"><h2>Priority action plan</h2>{% if report.priority_actions %}<ol class="actions">{% for action in report.priority_actions %}<li><span class="badge badge-{{ 'critical' if action.priority == 'P1' else 'warning' }}">{{ action.priority }}</span> <strong>{{ action.observation }}</strong><br><span class="muted">Likely cause:</span> {{ action.likely_cause }}<br><span class="muted">Action:</span> {{ action.recommended_action }} <span class="footnote">({{ action.source_type|replace('_',' ') }})</span></li>{% endfor %}</ol>{% else %}<p class="muted">No generated or manually logged actions were included in the frozen audit payload.</p>{% endif %}</section>
