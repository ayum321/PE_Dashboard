<section class="panel"><h2>Correlation and root-cause evidence</h2>{% if charts.correlation %}<div class="chart">{{ charts.correlation|safe }}</div>{% endif %}{% if report.correlation_rca %}<table><thead><tr><th>Event</th><th>Hosts</th><th>Metric</th><th class="numeric">Confidence</th><th>Disclosure</th></tr></thead><tbody>{% for event in report.correlation_rca[:30] %}<tr><td>{{ event.title or event.description or event.type or 'Correlation event' }}</td><td>{{ (event.vms or event.hosts or [])|join(', ') }}</td><td>{{ event.metric or '—' }}</td><td class="numeric">{{ event.confidence_pct if event.confidence_pct is not none else 'Not available' }}</td><td>Time correlation, not proof of causation.</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">No correlation events were supplied.</p>{% endif %}</section>
