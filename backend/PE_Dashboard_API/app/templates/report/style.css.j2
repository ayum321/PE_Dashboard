:root{--bg:#070b18;--bg-deep:#04060f;--panel:#0e1627;--panel-2:#101a2e;--panel-top:#13203a;--line:#1e2c4f;--line-soft:#16223d;--ink:#eef3ff;--ink-2:#aab8d4;--ink-3:#6b7a9c;--green:#10d96e;--amber:#f59e0b;--red:#f43f5e;--blue:#3b82f6;--purple:#a855f7;--cyan:#22d3ee}*{box-sizing:border-box}body{margin:0;background:radial-gradient(900px 480px at 11% -4%,rgba(61,31,118,.28),transparent 62%),radial-gradient(760px 460px at 92% 8%,rgba(11,99,168,.16),transparent 62%),var(--bg-deep);color:var(--ink);font:14px Inter,'Segoe UI',Arial,sans-serif;line-height:1.5}.report{max-width:1380px;margin:auto;padding:30px}.panel{position:relative;overflow:hidden;background:linear-gradient(145deg,rgba(19,32,58,.94),rgba(10,17,33,.98) 52%,rgba(9,15,29,.98));border:1px solid var(--line);border-radius:17px;padding:22px;margin:0 0 20px;box-shadow:0 20px 55px rgba(0,0,0,.24),inset 0 1px 0 rgba(255,255,255,.035);break-inside:avoid}.panel:before{content:"";position:absolute;inset:0 auto 0 0;width:2px;background:linear-gradient(var(--cyan),transparent 42%,var(--purple));opacity:.78}.panel-batch{border-color:#213e72}.panel-sow{border-color:#5c3c9b}.panel-resource{border-color:#14586f}.cover{border-top:2px solid var(--cyan);background:linear-gradient(105deg,rgba(59,130,246,.16),rgba(168,85,247,.12) 44%,rgba(8,15,30,.96))}h1{font-size:30px;letter-spacing:-.025em;margin:0 0 6px}h2{font-size:22px;letter-spacing:-.02em;margin:0}h3{font-size:15px;margin:20px 0 10px}h4{margin:0;color:#dce7ff;font-size:13px;text-transform:uppercase;letter-spacing:.08em}.panel-heading{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;border-bottom:1px solid var(--line-soft);padding-bottom:14px;margin-bottom:14px}.eyebrow,.kicker,.label{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:#7f98d2}.muted{color:var(--ink-2)}.strong{font-weight:750;color:#fff}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(175px,1fr));gap:12px}.metric{padding:13px 14px;border:1px solid #20345d;border-radius:12px;background:linear-gradient(145deg,rgba(24,39,70,.85),rgba(12,22,42,.95));box-shadow:inset 0 1px 0 rgba(255,255,255,.03)}.metric strong{display:block;margin-top:4px;color:#f3f7ff;font:700 22px 'Cascadia Code',Consolas,monospace}.pill,.badge{display:inline-flex;align-items:center;gap:4px;width:max-content;padding:4px 9px;border-radius:999px;font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;border:1px solid transparent}.pill-blue{color:#81b3ff;background:rgba(59,130,246,.12);border-color:rgba(59,130,246,.32)}.pill-cyan{color:#5ee7f7;background:rgba(34,211,238,.10);border-color:rgba(34,211,238,.30)}.badge-draft,.badge-not_assessed{background:#1c2941;color:#95a8c9;border-color:#304562}.badge-reviewed{background:rgba(59,130,246,.14);color:#8db8ff;border-color:rgba(59,130,246,.34)}.badge-customer_approved,.badge-healthy,.badge-ok,.badge-acceptable{background:rgba(16,217,110,.12);color:#4ce994;border-color:rgba(16,217,110,.34)}.badge-critical,.badge-critical_sustained,.badge-breach{background:rgba(244,63,94,.14);color:#ff7891;border-color:rgba(244,63,94,.36)}.badge-warning,.badge-at_risk,.badge-long_job,.badge-low{background:rgba(245,158,11,.13);color:#ffbf4f;border-color:rgba(245,158,11,.38)}.notice{border:1px solid rgba(245,158,11,.4);border-left:3px solid var(--amber);border-radius:10px;padding:11px 13px;background:rgba(245,158,11,.07);margin:12px 0}.error{border-color:rgba(244,63,94,.42);border-left-color:var(--red);background:rgba(244,63,94,.08)}.chart{margin:16px 0;overflow-x:auto;border-radius:12px}.chart-hero{box-shadow:0 0 34px rgba(59,130,246,.09)}.report-chart{display:block;min-width:720px;width:100%;height:auto;border:1px solid #20345d;border-radius:12px;background:#0b1324}table{width:100%;border-collapse:separate;border-spacing:0;font-family:'Cascadia Code',Consolas,monospace;font-size:12px;overflow:hidden;border:1px solid #1b3159;border-radius:11px}.data-table{box-shadow:inset 0 1px 0 rgba(255,255,255,.025)}th{background:linear-gradient(90deg,#08101f,#0b1427);font-family:Inter,'Segoe UI',Arial,sans-serif;font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:#87a1d9;text-align:left}th,td{padding:10px 11px;border-bottom:1px solid #192b4c;vertical-align:top}tbody tr:nth-child(even){background:rgba(18,31,55,.36)}tbody tr:hover{background:rgba(35,73,130,.22)}tbody tr:last-child td{border-bottom:0}.numeric{text-align:right;font-variant-numeric:tabular-nums}.negative{color:#ff7b92;font-weight:800}.status-row-breach,.critical-row{background:rgba(244,63,94,.075)!important}.status-row-long_job,.status-row-at_risk,.warning-row{background:rgba(245,158,11,.06)!important}.cadence{font-size:9px;font-weight:800;letter-spacing:.05em;color:#aab8d4}.cadence-daily{color:#5ee7f7}.cadence-weekly{color:#c490ff}.cadence-monthly{color:#ffc657}.actions{padding-left:18px}.actions li{margin:10px 0}.footnote{font-size:11px;color:#7f92b6}.role-group{margin-top:14px;padding:13px;border:1px solid #19365a;border-radius:12px;background:rgba(8,16,32,.42)}.snippet-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:10px;margin-top:10px}.server-snippet{padding:11px;border:1px solid #1d345c;border-radius:10px;background:linear-gradient(145deg,rgba(19,31,56,.95),rgba(9,17,32,.96));box-shadow:inset 0 1px 0 rgba(255,255,255,.025)}.snippet-heading{display:flex;justify-content:space-between;gap:9px}.snippet-heading strong{display:block;font-family:'Cascadia Code',Consolas,monospace;font-size:12px}.snippet-heading span:not(.badge){display:block;color:#7890bd;font-size:9px;font-weight:700;letter-spacing:.08em;margin-top:2px}.sparkline{margin:7px 0}.sparkline .report-chart{min-width:0;border:0;background:transparent}.compact{margin:5px 0;color:#aab8d4;font-size:10px;line-height:1.38}.compact b{color:#e0eaff}@media print{body{background:#fff;color:#111}.panel,.metric,.role-group,.server-snippet{background:#fff;border-color:#c6cedd;box-shadow:none}.report{max-width:none;padding:12px}.muted,.kicker,.label,.footnote,.compact{color:#555}.report-chart{min-width:0}.panel{break-inside:avoid}th{background:#edf1f8;color:#243149}.badge{color:#111;background:#eee;border-color:#ccc}}
