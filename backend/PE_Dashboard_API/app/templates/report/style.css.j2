:root{--bg:#0f1419;--panel:#1a1f2e;--panel2:#242938;--line:#3a4050;--text:#e8eaed;--muted:#9aa0a6;--critical:#ff4444;--warning:#ffaa00;--ok:#44bb44;--info:#4a9eff}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px 'Segoe UI',Arial,sans-serif;line-height:1.45}.report{max-width:1320px;margin:auto;padding:28px}.panel{background:var(--panel);border:1px solid #2a3040;border-radius:8px;padding:20px;margin:0 0 18px;break-inside:avoid}.cover{border-top:4px solid var(--info)}h1{font-size:28px;margin:0 0 6px}h2{font-size:20px;margin:0 0 12px}h3{font-size:15px;margin:14px 0 8px}.kicker,.label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--muted)}.muted{color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}.metric{padding:12px;border:1px solid var(--line);border-radius:6px;background:#111827}.metric strong{display:block;font:700 22px 'Cascadia Code',Consolas,monospace}.badge{display:inline-block;padding:3px 8px;border-radius:4px;font-size:11px;font-weight:700;letter-spacing:.04em}.badge-draft{background:#263244;color:var(--muted)}.badge-reviewed{background:rgba(74,158,255,.16);color:#82b7ff}.badge-customer_approved{background:rgba(68,187,68,.14);color:#6be76b}.badge-critical{background:rgba(255,68,68,.15);color:var(--critical)}.badge-warning{background:rgba(255,170,0,.14);color:var(--warning)}.badge-healthy,.badge-ok{background:rgba(68,187,68,.14);color:var(--ok)}.notice{border-left:4px solid var(--warning);padding:10px 12px;background:rgba(255,170,0,.08);margin:10px 0}.error{border-left-color:var(--critical);background:rgba(255,68,68,.08)}.chart{margin:14px 0;overflow-x:auto}.report-chart{display:block;min-width:720px;width:100%;height:auto;border:1px solid #2a3040;border-radius:8px}table{width:100%;border-collapse:collapse;font-family:'Cascadia Code',Consolas,monospace;font-size:12px}th{background:var(--panel2);font-family:'Segoe UI',Arial,sans-serif;font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);text-align:left}th,td{padding:9px 10px;border-bottom:1px solid #2a3040;vertical-align:top}.numeric{text-align:right;font-variant-numeric:tabular-nums}.critical-row{background:rgba(255,68,68,.08)}.warning-row{background:rgba(255,170,0,.07)}.actions{padding-left:18px}.actions li{margin:10px 0}.footnote{font-size:11px;color:var(--muted)}@media print{body{background:white;color:#111}.panel,.metric{background:#fff;border-color:#ccc}.report{max-width:none;padding:12px}.muted,.kicker,.label,.footnote{color:#555}.report-chart{min-width:0}.panel{break-inside:avoid}th{background:#eee;color:#333}}
