<section class="panel"><h2>Batch SLA</h2>{% if charts.batch_window %}<div class="chart">{{ charts.batch_window|safe }}</div>{% endif %}{% if charts.long_pole %}<div class="chart">{{ charts.long_pole|safe }}</div>{% endif %}<h3>Top jobs</h3><table><thead><tr><th>Job</th><th>Sub-app</th><th class="numeric">Peak hrs</th><th class="numeric">Average hrs</th><th class="numeric">SLA hrs</th><th>Status</th></tr></thead><tbody>{% for row in report.batch_sla.top_jobs_table[:20] %}<tr><td>{{ row.job_name or row.job or row.Job_Name or 'Unknown' }}</td><td>{{ row.sub_app or row.Sub_App or '—' }}</td><td class="numeric">{{ row.peak_hrs or row.peak_runtime or '—' }}</td><td class="numeric">{{ row.avg_hrs or row.average_hrs or '—' }}</td><td class="numeric">{{ row.sla_hrs or '—' }}</td><td>{{ row.status or '—' }}</td></tr>{% else %}<tr><td colspan="6" class="muted">No batch job table was loaded.</td></tr>{% endfor %}</tbody></table></section>
