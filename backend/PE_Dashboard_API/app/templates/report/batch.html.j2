<section class="panel panel-batch">
  <div class="panel-heading"><div><span class="eyebrow">Batch evidence</span><h2>Batch SLA</h2><p class="muted">Per-job SLA status is the same resolved status used by the dashboard.</p></div><span class="pill pill-blue">{{ report.batch_sla.top_jobs_table|length }} ranked jobs</span></div>
  {% if charts.batch_cadence %}<div class="chart chart-hero">{{ charts.batch_cadence|safe }}</div>{% endif %}
  <h3>Top jobs by peak runtime</h3>
  <table class="data-table"><thead><tr><th>Job</th><th>Sub-application</th><th>Cadence</th><th class="numeric">Peak hrs</th><th class="numeric">Average hrs</th><th class="numeric">SLA hrs</th><th class="numeric">Buffer %</th><th>Status</th></tr></thead><tbody>{% for row in report.batch_sla.top_jobs_table[:20] %}<tr class="status-row-{{ row.status|lower }}"><td class="strong">{{ row.job_name }}</td><td>{{ row.sub_app }}</td><td><span class="cadence cadence-{{ row.schedule_type|lower }}">{{ row.schedule_type|replace('_',' ') }}</span></td><td class="numeric">{{ '%.2f'|format(row.peak_hrs) if row.peak_hrs is not none else 'Not supplied' }}</td><td class="numeric">{{ '%.2f'|format(row.avg_hrs) if row.avg_hrs is not none else 'Not supplied' }}</td><td class="numeric">{{ '%.2f'|format(row.sla_hrs) if row.sla_hrs is not none else 'Not supplied' }}</td><td class="numeric {{ 'negative' if row.buffer_pct is not none and row.buffer_pct <= 0 else '' }}">{{ '%.1f%%'|format(row.buffer_pct) if row.buffer_pct is not none else 'Not assessed' }}</td><td><span class="badge badge-{{ row.status|lower }}">{{ row.status|replace('_',' ') }}</span></td></tr>{% else %}<tr><td colspan="8" class="muted">No batch job table was loaded.</td></tr>{% endfor %}</tbody></table>
  {% if report.batch_sla.excluded_jobs %}<p class="footnote">Excluded jobs: {{ report.batch_sla.excluded_jobs|length }}. See Methodology for the supplied exclusion rationale.</p>{% endif %}
</section>
