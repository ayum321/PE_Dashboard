<section class="panel"><h2>Change since prior audit</h2>{% if report.prior_audit_ref %}<p class="muted">Compared with {{ report.prior_audit_ref.audit_id }} generated {{ report.prior_audit_ref.generated_at }}.</p><div class="grid">{% for label, value in report.deltas.items() if label not in ['fleet_grade','sow_interpretation'] %}<div class="metric"><span class="label">{{ label|replace('_',' ') }}</span><strong>{{ value if value is not none else 'Not comparable' }}</strong></div>{% endfor %}</div><p class="footnote">Fleet grade: {{ report.deltas.fleet_grade.prior }} → {{ report.deltas.fleet_grade.current }} · SOW interpretation: {{ report.deltas.sow_interpretation.prior }} → {{ report.deltas.sow_interpretation.current }}</p>{% else %}<p class="muted">{{ report.deltas.message if report.deltas else 'First audit; no baseline is available.' }}</p>{% endif %}</section>
