<section class="panel"><h2>Resource utilisation</h2>{% set fleet = report.resource_review.fleet_summary %}{% if fleet %}<div class="grid"><div class="metric"><span class="label">Fleet grade</span><strong>{{ fleet.grade }}{% if fleet.score is not none %} · {{ fleet.score }}{% endif %}</strong></div><div class="metric"><span class="label">Servers</span><strong>{{ fleet.servers_total }}</strong></div><div class="metric"><span class="label">Exceptions</span><strong>{{ fleet.critical }} critical · {{ fleet.warning }} warning</strong></div><div class="metric"><span class="label">No data</span><strong>{{ fleet.no_data }}</strong></div></div>{% else %}<div class="notice error">No upstream fleet summary was supplied. This export does not invent a fleet grade or health count.</div>{% endif %}{% if charts.fleet_heatmap %}<div class="chart">{{ charts.fleet_heatmap|safe }}</div>{% endif %}{% if charts.exception_timeseries %}<div class="chart">{{ charts.exception_timeseries|safe }}</div>{% endif %}<h3>Exception-first host table</h3><table><thead><tr><th>Host</th><th>Role</th><th>Environment</th><th class="numeric">CPU %</th><th class="numeric">Memory %</th><th class="numeric">Disk %</th><th>Evidence</th><th>Status</th></tr></thead><tbody>{% for row in report.resource_review.exception_table %}<tr class="{{ 'critical-row' if row.status == 'CRITICAL' else 'warning-row' }}"><td>{{ row.host }}</td><td>{{ row.role }}</td><td>{{ row.environment }}</td><td class="numeric">{{ row.cpu_pct if row.cpu_pct is not none else 'Not emitted' }}</td><td class="numeric">{{ row.memory_pct if row.memory_pct is not none else 'Not emitted' }}</td><td class="numeric">{{ row.disk_pct if row.disk_pct is not none else 'Not emitted' }}</td><td>{{ row.exception_reason }}{% if row.max_anomaly_z is not none %} · z={{ row.max_anomaly_z }}{% endif %}</td><td><span class="badge badge-{{ row.status|lower }}">{{ row.status }}</span></td></tr>{% else %}<tr><td colspan="8" class="muted">No non-healthy host or z-score ≥2 anomaly was supplied.</td></tr>{% endfor %}</tbody></table><p class="footnote">CPU and disk: higher percentage means more pressure. Memory is available memory percentage: lower means more pressure.</p></section>
