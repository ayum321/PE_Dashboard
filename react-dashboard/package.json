{
  "name": "pe-dashboard-mfe",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@by/lui-dashboard-library": "^1.8.24",
    "@date-io/date-fns": "^1.3.13",
    "@jda/cra-template-luminate-create-mfe": "2.4.7",
    "@jda/lui-common-component-library-mui5": "^3.1.0",
    "@jda/lui-common-icon-library-mui5": "^1.0.0",
    "@jda/lui-dashboard-scaffolding-layouts": "^3.3.2",
    "@jda/lui-portal-utilities": "^3.20.8",
    "@material-ui/pickers": "^3.3.10",
    "@mui/icons-material": "^5.14.3",
    "@mui/lab": "^5.0.0-alpha.120",
    "@mui/material": "^5.14.4",
    "axios": "^1.6.0",
    "date-fns": "^2.30.0",
    "highcharts-react-official": "^3.2.1",
    "react": "^18.3.1",
    "react-breadcrumbs": "^2.1.7",
    "react-dom": "^18.3.1",
    "react-router-dom": "^5.3.4",
    "react-scripts": "5.0.1",
    "use-memo-one": "^1.1.3",
    "web-vitals": "^3.5.0"
  },
  "scripts": {
    "start": "node .github/scripts/prepareVendorSources.js && concurrently \"npm run setLocalEnv --silent && cross-env PORT=3000 BROWSER=none react-scripts --openssl-legacy-provider start\" \"launch-luminate-portal\"",
    "build": "node .github/scripts/prepareVendorSources.js && react-scripts --max_old_space_size=4096 --openssl-legacy-provider build",
    "test": "node .github/scripts/prepareVendorSources.js && npm run setLocalEnv --silent && react-scripts test --coverage --watchAll=false",
    "eject": "react-scripts eject",
    "setLocalEnv": "cross-env DOTENV_CONFIG_PATH=./.github/envs/.env node -r dotenv/config .github/scripts/setRuntimeEnv.js public/",
    "prepare:vendor": "node .github/scripts/prepareVendorSources.js",
    "start:standalone": "node .github/scripts/prepareVendorSources.js && npm run setLocalEnv --silent && cross-env HOST=127.0.0.1 PORT=3000 react-scripts start",
    "check:api-contract": "node scripts/check-api-contract.js",
    "test-no-coverage": "react-scripts test",
    "lint": "eslint src/**/*.ts src/**/*.tsx",
    "prettier": "prettier --check src/**/*.js src/**/*.jsx src/**/*.ts src/**/*.tsx",
    "format": "prettier --write src/**/*.ts src/**/*.tsx",
    "pre-commit": "concurrently \"npm run format\" \"npm run lint\" \"npm run test\"",
    "clear-jest": "jest --clearCache",
    "update-portal-dependencies": "node .github/scripts/updatePortalDependencies.js"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@by/plat-lui-portal": "^1.19.3",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^11.2.7",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.5",
    "@types/node": "^18.18.5",
    "@types/react-breadcrumbs": "^2.1.6",
    "@types/react-dom": "^16.9.20",
    "@types/react-router-dom": "^5.3.3",
    "chalk": "^4.1.2",
    "concurrently": "^8.2.1",
    "cross-env": "^7.0.3",
    "decompress": "^4.2.1",
    "dotenv": "^16.3.1",
    "dotenv-override": "^5.0.1",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.33.2",
    "husky": "^8.0.3",
    "jest-canvas-mock": "^2.5.2",
    "local-web-server": "^5.3.0",
    "prettier": "^2.8.8",
    "read-dir-files": "^0.1.1",
    "service-worker-mock": "^2.0.5",
    "typescript": "5.0.4"
  },
  "jest": {
    "coveragePathIgnorePatterns": [
      "src/serviceWorker.ts",
      "src/index.tsx"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 0,
        "branches": 0,
        "functions": 0,
        "lines": 0
      }
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@jda/lui-common-icon-library|axios/))"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run pre-commit",
      "pre-push": "npm run build"
    }
  }
}
