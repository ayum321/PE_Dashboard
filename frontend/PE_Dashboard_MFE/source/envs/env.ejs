<%
const json = (value) => JSON.stringify(String(value || ''))
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/&/g, '\\u0026');
%>
window["env"] = {
  LOCAL_APP_NAME: <%- json(data.appName || 'PE Audit Dashboard') %>,
  FRAME_URL_PATH: <%- json(data.frameUrlPath || '/') %>,
  API_BASE_URL: <%- json(data.apiBaseUrl || '') %>,
};
